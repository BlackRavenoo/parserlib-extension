{
  "manifest_version": 3,
  "name": "ParserLib Extension",
  "version": "0.1.0",
  "description": "Скачивание манги/новелл из поддерживаемых источников с экспортом в fb2/epub/pdf",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "scripting",
    "storage",
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://mangalib.me/*",
    "*://mangalib.org/*",
    "*://hentailib.me/*",
    "*://ranobelib.me/*",
    "https://hapi.hentaicdn.org/*",
    "https://cover.hentaicdn.org/*",
    "https://img3h.hentaicdn.org/*",
    "https://img2.mixlib.me/*",
    "https://*.cdnlibs.org/*",
  ],
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "121.0"
    }
  }
}
