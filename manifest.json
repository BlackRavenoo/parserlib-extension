{
  "manifest_version": 3,
  "name": "ParserLib Extension",
  "version": "0.1.0",
  "description": "Скачивание манги/новелл из поддерживаемых источников с экспортом в fb2/epub/pdf",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": [
    "storage",
    "cookies",
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://mangalib.me/*",
    "*://mangalib.org/*",
    "*://ranobelib.me/*",
    "https://api.cdnlibs.org/*",
    "https://cover.cdnlibs.org/*",
    "https://img2.mixlib.me/*",
    "https://img3.mixlib.me/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.mangalib.me/*", "*://*.mangalib.org/*"],
      "js": ["content/mangalib-token.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.ranobelib.me/*"],
      "js": ["content/ranobelib-token.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "parserlib-extension@example.invalid",
      "strict_min_version": "115.0"
    }
  }
}
